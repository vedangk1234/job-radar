# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# Both URLs point at the Supabase POOLER host (aws-0-<region>.pooler.supabase.com),
# NOT db.<ref>.supabase.co. The direct db.* endpoint is IPv6-only and GitHub Actions
# runners are IPv4-only, so the direct endpoint would break the scheduled crawler.
#
# Find these in Supabase: Project Settings -> Database -> Connection string.
# The username is postgres.<project-ref> (dot, not @) for pooler connections.

# Session pooler, port 5432 — used by the Python crawler (asyncpg).
# Session mode supports the full Postgres protocol, which is what asyncpg wants.
CRAWLER_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Transaction pooler, port 6543 — used later by the Next.js dashboard (serverless-friendly).
DASHBOARD_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# OPTIONAL. The pooler's certificate is signed by Supabase's own private CA, which
# is in no system trust store, so by default we connect with sslmode=require
# semantics (encrypted, certificate not verified). To verify for real, download
# your project's CA (Project Settings -> Database -> SSL Configuration ->
# Download certificate) and point this at the file. Leave unset otherwise.
# SUPABASE_CA_CERT=./db/prod-ca-2021.crt

# Email delivery (used in a later step, not by init_db.py).
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=onboarding@resend.dev
MY_EMAIL=you@example.com
