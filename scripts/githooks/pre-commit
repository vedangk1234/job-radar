#!/bin/sh
#
# job-radar secret guard. Refuses a commit that would put a credential into
# git history.
#
# Enable it once per clone:
#
#     git config core.hooksPath scripts/githooks
#
# A hook is not a security boundary — anyone can pass --no-verify, and it only
# ever sees what is STAGED. It exists because the alternative is trusting
# yourself to remember, and the failure mode is a rotated Supabase password and
# a rewritten history. Treat a block as correct until proven otherwise.
#
# Three checks, all against staged content rather than the working tree, so a
# `git add -p` of a hunk containing a key is caught even when the file on disk
# looks clean:
#
#   1. FORBIDDEN NAMES — files that exist only to hold real values.
#   2. SECRET SHAPES   — literals shaped like credentials, wherever they
#                        appear, including inside a file with an innocent name.
#   3. PERSONAL DATA   — a contact address or the committer's own identity
#                        baked into a committed file instead of read from env.
#
# Checks 2 and 3 read the whole staged blob, not just the added lines. Slightly
# stricter than they need to be, and deliberately: a secret three commits old
# that you are now editing around is still a secret.
#
# Self-reference note: this script names the shapes it hunts for, so two
# patterns are assembled from halves ('GOCSP''X-') the shell rejoins at
# runtime. Without that the guard would refuse to let itself be committed.
# There is deliberately no path allowlist — an allowlisted path is exactly
# where a secret would learn to hide.

set -u

# --- 1. names that never belong in a commit -------------------------------
# Exact basename matches. `.env.example` and `.env.local.example` are NOT on
# this list on purpose: they are the committed templates, and they hold
# placeholders.
FORBIDDEN_NAMES='.env .env.local scratch.md'

# --- 2. shapes that look like credentials ---------------------------------
# Assembled so the guard does not match its own source. See note above.
GOOGLE_SECRET='GOCSP''X-'
SUPABASE_REF='qfbegmglknn''oyfrgoouc'

# The \b matters for the same reason it matters in notify/match.py, and it was
# missing for the same reason: `re_` is not a rare string, it is the middle of
# every snake_case identifier containing the letters. Without a left boundary
# this fired on `test_..._are_never_read_as_experience` and on four other test
# names in tests/test_description.py, which meant the guard blocked every commit
# that touched that file — and a guard that cries wolf is a guard that teaches
# you to reach for --no-verify. A real key is preceded by a quote, an `=` or a
# space, all of which are boundaries; none of them is a letter.
RESEND_KEY='\bre_[A-Za-z0-9_-]{20,}'

# `sk-` has to look like a key rather than merely be a substring: those three
# characters also sit inside task-, risk- and disk-, and a guard that cries
# wolf on ordinary prose is a guard that gets bypassed with --no-verify. The
# \b kills those; the length floor is one a real OpenAI/Anthropic key clears.
OPENAI_KEY='\bsk-[A-Za-z0-9_-]{16,}'

# A postgres URL carrying a real password. The `[^<>@[:space:]]` password class
# is what lets .env.example and dashboard/.env.local.example through: their
# password field is the literal placeholder <password>, and a placeholder is
# not a leak.
PG_URL_WITH_PASSWORD='postgres(ql)?://[^:@/[:space:]]+:[^<>@[:space:]]{3,}@'

PATTERNS="$RESEND_KEY|$GOOGLE_SECRET|$OPENAI_KEY|$SUPABASE_REF|$PG_URL_WITH_PASSWORD"

# --- 3. personal data -----------------------------------------------------
# A contact address or handle belongs in .env, read at runtime with a neutral
# fallback (see fetchers/http.py and dashboard/src/lib/ats.ts), never as a
# literal in a committed file. Enforcing that needs to know the values — and
# writing them here would put them in the repo, which is the exact thing being
# prevented. So none of the three rules below names a person:
#
#   A. STRUCTURAL  any address on a domain that is not reserved for examples.
#                  Catches a real contact address without knowing which one,
#                  and keeps catching it after the owner's address changes.
#   B. IDENTITY    git config user.email / user.name, read at run time. Whoever
#                  is making the commit is precisely who must not appear in its
#                  content, so the guard needs no configuration to work.
#   C. EXPLICIT    PERSONAL_DENYLIST in the environment, or git config
#                  jobradar.personalDenylist, for what the first two miss: an
#                  old address, or a handle that differs from user.name.
#
# Rule A is the one that matters, and it is a whitelist inverted rather than a
# denylist: RFC 2606 and 6761 reserve example.com/.net/.org/.edu and the .test,
# .example, .invalid and .localhost TLDs so that documentation and fixtures can
# name an address that can never be a person's. An address on one of those is
# not personal data; anything else is assumed to be until proven otherwise.

# The leading class excludes ':' so that the credentials in a connection URL of
# the form postgres://user:<password>@host are not read as an address, the user
# being followed by ':' where a local part never is. That shape is check 2's job
# and this file's own test carries one on purpose. (The placeholder spelling
# here is not incidental: check 2 would flag the literal form, correctly.)
EMAIL_RE='(^|[^:A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'

# Anchored at the end because grep -o emits one address per line, so '$' is the
# end of the address itself. onboarding@resend.dev is Resend's shared sandbox
# sender — a published vendor constant, not a person, and the documented FROM
# for an account with no verified domain, so .env.example, notify/digest.py and
# the digest tests all name it.
#
# That vendor constant needs a LEFT boundary as well as the '$'. With only the
# right anchor it read as "any address ENDING in the allowed one", so a local
# part with anything glued to the front of 'onboarding' — x…, evil…, a real
# mailbox — inherited the exemption by suffix. (Those examples are described
# rather than spelled: written out in full they are addresses this very check
# now blocks, and the hook must not block its own source. Same reason the two
# patterns above are assembled from halves.) The boundary is
# not a bare '^' because EMAIL_RE captures the character in front of the
# address (see the note above it), so grep -o emits " onboarding@resend.dev"
# with its leading separator; '^' would never match. '(^|[^A-Za-z0-9._%+-])'
# accepts either the start of the line or exactly the separator EMAIL_RE ate,
# and rejects a local part that merely ends in the allowed one.
EMAIL_ALLOWED='@(example\.(com|net|org|edu)|localhost)$|\.(test|example|invalid|localhost)$|(^|[^A-Za-z0-9._%+-])onboarding@resend\.dev$'

# Never treated as personal even when they are the git identity: a CI robot or
# a placeholder name would otherwise match half the repo and teach you to reach
# for --no-verify. Short tokens are dropped for the same reason (below).
GENERIC_IDENTITY=' user admin administrator test tests dev devel root ubuntu runner github actions gitlab jenkins docker node python local localhost example unknown nobody noreply none null your name email '

# Rules B and C, resolved to one alternation. Lowercased and matched with -i:
# an address is case-insensitive in its domain and conventionally in its local
# part, and a handle gets typed both ways.
DENY_RE=''
for value in $(
	{
		git config user.email
		git config user.name
		git config user.email | sed 's/@.*//'
		git config --get-all jobradar.personalDenylist
		printf '%s\n' "${PERSONAL_DENYLIST:-}" | tr ',;' '  '
	} 2>/dev/null | tr 'A-Z' 'a-z' | sort -u
); do
	# 5 characters is the floor because a 4-letter identity ("dave", "test") is
	# a substring of too much ordinary text. A name that short needs
	# PERSONAL_DENYLIST and an explicit decision.
	[ "${#value}" -lt 5 ] && continue
	case "$GENERIC_IDENTITY" in
	*" $value "*) continue ;;
	esac
	escaped=$(printf '%s' "$value" | sed 's/[][\.^$*+?(){}|]/\\&/g')
	if [ -z "$DENY_RE" ]; then
		DENY_RE=$escaped
	else
		DENY_RE="$DENY_RE|$escaped"
	fi
done

RED='' BOLD='' DIM='' RESET=''
if [ -t 2 ]; then
	RED=$(printf '\033[31m')
	BOLD=$(printf '\033[1m')
	DIM=$(printf '\033[2m')
	RESET=$(printf '\033[0m')
fi

blocked=0
header() {
	if [ "$blocked" -eq 0 ]; then
		printf '\n%s%sCOMMIT BLOCKED%s — the secret guard found something.\n\n' \
			"$RED" "$BOLD" "$RESET" >&2
	fi
	blocked=1
}

# No HEAD yet (the very first commit)? Diff against the empty tree.
if git rev-parse --verify HEAD >/dev/null 2>&1; then
	against=HEAD
else
	against=$(git hash-object -t tree /dev/null)
fi

list=$(git diff --cached --name-only --diff-filter=ACMR "$against")
[ -z "$list" ] && exit 0

# A here-doc rather than a pipe: a `while read` on the right of a pipe runs in
# a subshell, and every `blocked=1` it sets would be discarded on exit.
while IFS= read -r path; do
	[ -z "$path" ] && continue

	base=${path##*/}
	for name in $FORBIDDEN_NAMES; do
		if [ "$base" = "$name" ]; then
			header
			printf '  %sforbidden filename%s  %s\n' "$BOLD" "$RESET" "$path" >&2
			printf '    %sthis file holds real values; only its .example twin is committed%s\n\n' \
				"$DIM" "$RESET" >&2
		fi
	done

	# -I skips binaries; -n gives the line so the report is actionable. `git
	# show :path` reads the staged blob, which is the thing about to be
	# committed — not the working copy, which may differ.
	hits=$(git show ":$path" 2>/dev/null | grep -I -n -E "$PATTERNS" 2>/dev/null | head -5)
	if [ -n "$hits" ]; then
		header
		printf '  %ssecret-shaped literal%s  %s\n' "$BOLD" "$RESET" "$path" >&2
		# Print only the line NUMBER and the matched shape, never the
		# surrounding line: echoing the key into a terminal scrollback (and
		# from there into a bug report) is the leak this hook exists to stop.
		printf '%s\n' "$hits" | while IFS= read -r hit; do
			printf '    line %s%s\n' "${hit%%:*}" "$RESET" >&2
		done
		printf '    %smatched one of: re_… | %s… | sk-… | supabase project ref | postgres:// with password%s\n\n' \
			"$DIM" "$GOOGLE_SECRET" "$RESET" >&2
	fi

	# Check 3A. grep -o prints one address per line so the allow-list can anchor
	# on the address rather than on the surrounding text; -n survives -o, giving
	# `LINE:address`. The address IS printed here, unlike a secret above: it is
	# what makes the block actionable, it is not a credential, and it is already
	# in a file you are holding.
	mail=$(git show ":$path" 2>/dev/null |
		grep -I -n -o -E "$EMAIL_RE" 2>/dev/null |
		grep -i -v -E "$EMAIL_ALLOWED" 2>/dev/null | head -5)
	if [ -n "$mail" ]; then
		header
		printf '  %sreal contact address%s  %s\n' "$BOLD" "$RESET" "$path" >&2
		printf '%s\n' "$mail" | while IFS= read -r hit; do
			printf '    line %s%s\n' "$hit" "$RESET" >&2
		done
		printf '    %sread it from the environment instead (MY_EMAIL, ALLOWED_EMAIL) with an\n' "$DIM" >&2
		printf '    example.com fallback; a fixture address needs an example/.test domain%s\n\n' "$RESET" >&2
	fi

	# Check 3B/3C. Line numbers only: the matched token is the committer's own
	# name or address, and echoing it into a terminal is what the report of a
	# personal-data leak should not do.
	if [ -n "$DENY_RE" ]; then
		own=$(git show ":$path" 2>/dev/null |
			grep -I -n -i -E "$DENY_RE" 2>/dev/null | head -5)
		if [ -n "$own" ]; then
			header
			printf '  %spersonal identity%s  %s\n' "$BOLD" "$RESET" "$path" >&2
			printf '%s\n' "$own" | while IFS= read -r hit; do
				printf '    line %s%s\n' "${hit%%:*}" "$RESET" >&2
			done
			printf '    %smatched your git identity or PERSONAL_DENYLIST — keep your name and\n' "$DIM" >&2
			printf '    handle out of committed files; read them from env at run time%s\n\n' "$RESET" >&2
		fi
	fi
done <<EOF
$list
EOF

if [ "$blocked" -ne 0 ]; then
	cat >&2 <<'MSG'
Fix it, do not bypass it:
  - move the value into .env (gitignored) and reference it by name
  - `git restore --staged <path>` to unstage the file
  - if the value already reached a remote, it is burned: rotate it first
  - a personal-data hit that is genuinely a false positive belongs in the
    allow-list in this hook, with a note saying why it is not a person

--no-verify exists and this hook cannot stop you. It can only make sure
the decision is one you made on purpose.
MSG
	exit 1
fi

exit 0
