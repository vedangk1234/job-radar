# Copy this file to dashboard/.env.local and fill in real values.
# .env.local is gitignored AND blocked by the pre-commit secret guard — never commit it.
#
# On Vercel these same six names go in Project Settings -> Environment Variables,
# with the project's Root Directory set to `dashboard`.

# --- Google OAuth ----------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (Web application).
#
# Authorised redirect URIs must include, exactly:
#   http://localhost:3000/api/auth/callback/google      (local dev)
#   https://<your-vercel-domain>/api/auth/callback/google   (once deployed)
#
# The production one cannot be added until the Vercel domain exists. Sign-in
# will fail with redirect_uri_mismatch until it is.
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-client-secret>

# --- Session signing -------------------------------------------------------
# Signs the session cookie. Any high-entropy string; generate one with:
#   npx auth secret          (writes it for you)
#   openssl rand -base64 32
# Changing it invalidates every existing session, which is also how you log
# yourself out everywhere.
AUTH_SECRET=<random-32-bytes-base64>

# --- The single authorised user -------------------------------------------
# Google authenticates ANY Google account. This is the line that decides which
# one is allowed in. If it is unset, NOBODY can sign in — the check fails
# closed on purpose.
ALLOWED_EMAIL=you@example.com

# --- Outbound contact address ----------------------------------------------
# Goes into the User-Agent the "add a company" probe sends to ATS boards, so a
# board owner who sees us in their logs can reach a human. Same value and same
# purpose as MY_EMAIL in ../.env, which the Python crawler reads; the dashboard
# needs its own copy because Vercel deploys with Root Directory set to
# `dashboard` and never sees the parent .env.
#
# Server-side only — deliberately NOT prefixed NEXT_PUBLIC_, so it is never
# shipped to the browser. If unset the probe falls back to unknown@example.com,
# which works but is impolite; set it.
MY_EMAIL=you@example.com

# --- Database --------------------------------------------------------------
# Supabase TRANSACTION pooler, port 6543 (not 5432 — that is the session pooler
# the Python crawler uses). Transaction mode hands a connection back to the pool
# after every transaction, which is what a serverless dashboard wants and is
# also why prepared statements are disabled in src/lib/db.ts. Same database as
# CRAWLER_DB_URL in ../.env, different port and different pooling mode.
DASHBOARD_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Optional --------------------------------------------------------------
# Set only if Auth.js cannot work out its own URL (some proxy setups). Local dev
# and Vercel both infer it correctly, so leave this commented out.
# AUTH_URL=https://<your-vercel-domain>
